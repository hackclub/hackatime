<clickhouse>
    <profiles>
        <app>
            <max_memory_usage>8589934592</max_memory_usage>
            <max_execution_time>120</max_execution_time>
            <max_threads>8</max_threads>
            <!-- Heartbeat ingest: buffer small inserts server-side, but only
                 acknowledge once the data is on disk. -->
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
            <async_insert_deduplicate>1</async_insert_deduplicate>
            <!-- Spill big admin aggregations to disk instead of failing. -->
            <max_bytes_before_external_group_by>4294967296</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>4294967296</max_bytes_before_external_sort>
            <!-- Rollup rebuilds need correct local-day conversion; never allow
                 the non-constant timezone mode that silently returns wrong dates. -->
            <allow_nonconst_timezone_arguments>0</allow_nonconst_timezone_arguments>
            <!-- Postgres semantics for max/min/sum over zero rows: NULL, not 0. -->
            <aggregate_functions_null_for_empty>1</aggregate_functions_null_for_empty>
        </app>
    </profiles>
    <users>
        <hackatime>
            <profile>app</profile>
            <!-- Lets the app user create the hackatime database, run migrations,
                 and create the read-only analyst user via SQL. -->
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
        </hackatime>
    </users>
</clickhouse>
