{
  "private": true,
  "type": "module",
  "scripts": {
    "build:docs": "rm -rf public/docs public/og/docs public/og/docs.png public/_astro public/blume-search.json public/docs.md public/docs.mdx public/docs-sitemap.xml public/agent-readability.json public/llms.txt public/llms-full.txt && bun x --bun blume build && mkdir -p public/og && cp -R dist/docs dist/_astro public/ && cp -R dist/og/. public/og/ && cp dist/sitemap.xml public/docs-sitemap.xml && cp dist/blume-search.json dist/docs.md dist/docs.mdx dist/agent-readability.json dist/llms.txt dist/llms-full.txt public/",
    "check": "bun run check:svelte && tsc -p tsconfig.node.json",
    "check:svelte": "svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.svelte-check.json",
    "format:svelte": "prettier --write \"app/javascript/**/*.svelte\"",
    "format:svelte:check": "prettier --check \"app/javascript/**/*.svelte\"",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource-variable/spline-sans": "^5.3.0",
    "@img/sharp-libvips-linux-arm64": "1.3.2",
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@inertiajs/svelte": "^3.6.1",
    "@inertiajs/vite": "^3.6.1",
    "@js-from-routes/client": "^1.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "bits-ui": "^2.18.1",
    "blume": "^1.4.2",
    "canvas-confetti": "^1.9.4",
    "d3-array": "3.2.4",
    "d3-shape": "^3.2.0",
    "hcicons-svelte": "0.2.2",
    "plur": "^6.0.0",
    "runed": "^0.37.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-hero-icons": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "virtua": "^0.49.3",
