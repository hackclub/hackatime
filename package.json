{
  "private": true,
  "type": "module",
  "scripts": {
    "build:docs": "rm -rf public/docs public/blume-nav public/og/docs public/og/docs.png public/_astro public/blume-search.json public/docs.md public/docs.mdx public/docs-sitemap.xml public/agent-readability.json public/llms.txt public/llms-full.txt && bun x --bun blume build && mkdir -p public/og && cp -R dist/docs dist/_astro dist/blume-nav public/ && cp -R dist/og/. public/og/ && cp dist/sitemap.xml public/docs-sitemap.xml && cp dist/blume-search.json dist/docs.md dist/docs.mdx dist/agent-readability.json dist/llms.txt dist/llms-full.txt public/",
    "check": "bun run check:svelte && tsc -p tsconfig.node.json",
    "check:svelte": "svelte-check --tsgo --workspace app/javascript --config ../../svelte.config.js --tsconfig ../../tsconfig.svelte-check.json",
    "format:svelte": "oxfmt --write \"app/javascript/**/*.svelte\"",
    "format:svelte:check": "oxfmt --check \"app/javascript/**/*.svelte\"",
    "lint": "oxlint --import-plugin app/javascript",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource-variable/spline-sans": "^5.3.0",
    "@img/sharp-libvips-linux-arm64": "1.3.3",
    "@img/sharp-libvips-linux-x64": "1.3.3",
    "@inertiajs/svelte": "^3.11.0",
    "@inertiajs/vite": "^3.11.0",
    "@js-from-routes/client": "^1.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "beasties": "^0.5.5",
    "bits-ui": "^2.21.0",
    "blume": "^2.2.7",
    "canvas-confetti": "^1.9.4",
    "d3-array": "3.2.4",
    "d3-shape": "^3.2.1",
    "hcicons-svelte": "0.2.2",
    "plur": "^6.0.0",
    "runed": "^0.38.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-hero-icons": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "virtua": "^0.54.2",
    "vite": "^8.3.8",
    "vite-plugin-ruby": "^5.2.6"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-array": "3.2.2",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "knip": "^6.45.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "1.65.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
