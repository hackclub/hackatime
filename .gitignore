# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/legacy/rails/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/legacy/rails/log/*
/legacy/rails/tmp/*
!/legacy/rails/log/.keep
!/legacy/rails/tmp/.keep

# Ignore pidfiles, but keep the directory.
/legacy/rails/tmp/pids/*
!/legacy/rails/tmp/pids/
!/legacy/rails/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/legacy/rails/storage/*
!/legacy/rails/storage/.keep
/legacy/rails/tmp/storage/*
!/legacy/rails/tmp/storage/
!/legacy/rails/tmp/storage/.keep

/legacy/rails/public/assets

# Ignore master key for decrypting credentials and more.
/legacy/rails/config/master.key

# Ignore environment variables
.env
.env.*.local
!.env.example

/legacy/rails/app/assets/builds/*
!/legacy/rails/app/assets/builds/.keep

# Generated by `bin/rake js_from_routes:generate` (regenerated on Rails boot
# in dev, by entrypoint.dev.sh on container start, and by Dockerfile/CI in
# production builds). See config/initializers/js_from_routes.rb.
/legacy/rails/app/javascript/api

.idea
.DS_Store

node_modules
/legacy/rails/public/vite-dev
/legacy/rails/public/vite-ssr
/legacy/rails/public/vite-test

.vite

pg-dump*

