#!/usr/bin/env bash
set -euo pipefail

if ! sudo docker info >/dev/null 2>&1; then
  if systemctl cat amp-svc-docker-daemon.service >/dev/null 2>&1; then
    amp orb service restart docker-daemon
  else
    amp orb service start docker-daemon --command 'sudo dockerd'
  fi

  for _ in $(seq 1 8); do
    sudo docker info >/dev/null 2>&1 && break
    sleep 1
  done
fi

sudo docker info >/dev/null
sudo docker compose up -d

# The portal generates js_from_routes helpers on boot, which corrupts them if
# the web entrypoint is still generating them.
for _ in $(seq 1 600); do
  [ "$(sudo docker compose exec -T web cat /proc/1/comm 2>/dev/null)" = sleep ] && break
  sleep 1
done
[ "$(sudo docker compose exec -T web cat /proc/1/comm)" = sleep ]

amp orb services ensure
